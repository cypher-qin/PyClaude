# ============================================================================
#  myagent 配置 —— 复制本文件为 .env 后填入你自己的值
#  cp .env.example .env
# ============================================================================

# 你的 API Key（Kimi/Moonshot 控制台获取，形如 sk-...）
ANTHROPIC_API_KEY=sk-你的-moonshot-key

# 模型 id —— 必填。请到 Kimi 控制台确认当前可用的模型名后填写。
MODEL_ID=kimi-k2-0711-preview

# Base URL —— 接第三方「Anthropic 兼容」网关时必填。
#   国内: https://api.moonshot.cn/anthropic
#   海外: https://api.moonshot.ai/anthropic
ANTHROPIC_BASE_URL=https://api.moonshot.cn/anthropic

# 可选：过载(529)时自动切换的备用模型 id
# FALLBACK_MODEL_ID=

# ============================================================================
#  MCP（Model Context Protocol）—— 两条实现路径，一键切换
# ============================================================================
#   off     不启用（默认）
#   manual  手写 client（mcp_manual/client.py + github_server.py）
#           纯 stdlib，能看到 initialize / tools/list / tools/call 全过程
#   sdk     官方 mcp SDK（pip install mcp）—— 生产级，协议细节由 SDK 负责
MCP_MODE=off

# 连哪个 MCP server（JSON 数组）。留空 = 本项目手写的 github server（免 token）。
# 真·生产配置：官方 GitHub MCP server（需 Docker Desktop 运行 + GITHUB_TOKEN）
# MCP_SERVER_CMD=["docker","run","-i","--rm","-e","GITHUB_PERSONAL_ACCESS_TOKEN","ghcr.io/github/github-mcp-server"]
MCP_SERVER_CMD=

# 逻辑名，决定工具前缀 mcp__{名字}__{工具}
# MCP_SERVER_NAME=github

# GitHub token（可选）：不填也能搜公开仓库(限速低)，填了升到 5000 次/时。
# 只注入 server 子进程，不进模型上下文。
GITHUB_TOKEN=

# 打开后在 stderr 打印每一条 JSON-RPC 报文（学习/排错用）
# MCP_DEBUG=1

# ----------------------------------------------------------------------------
#  切换到其它「Anthropic 兼容」厂商时，只改上面三行即可（代码不用动）：
#
#  厂商            ANTHROPIC_BASE_URL                       MODEL_ID(示例)
#  -------------   --------------------------------------   ----------------
#  Kimi(国内)      https://api.moonshot.cn/anthropic        kimi-k2-0711-preview
#  Kimi(海外)      https://api.moonshot.ai/anthropic        kimi-latest
#  官方 Anthropic  (留空即可)                                claude-sonnet-4-5
#  DeepSeek        https://api.deepseek.com/anthropic       deepseek-chat
#  GLM(智谱)       https://open.bigmodel.cn/api/anthropic   glm-4.6
#
#  注意：以上模型 id 仅为示例，实际以各厂商控制台/文档为准。
# ----------------------------------------------------------------------------
